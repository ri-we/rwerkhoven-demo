# Local WordPress development environment (Docker Compose).
# Copy to .env and adjust if needed. Never commit the real .env file.

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wordpress

WORDPRESS_PORT=8080
WORDPRESS_SITE_URL=http://localhost:8080
WORDPRESS_SITE_TITLE="Ron Werkhoven Bouwkundig Ontwerp- en Tekenbureau"

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-locally
WORDPRESS_ADMIN_EMAIL=dev@example.com
